# Koyra One v1
# Required for stable private UUID. Use a long random phrase.
KOYRA_KEY=change-this-to-a-long-private-random-key

# Optional: set exact UUID instead of KOYRA_KEY-derived UUID
# KOYRA_UUID=xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx

# Optional: change WebSocket path
KOYRA_PATH=/koyra

# Optional: protect subscription/config endpoints
# KOYRA_SUB_TOKEN=my-private-sub-token

# Optional: admin debug key for /debug?key=...
# KOYRA_ADMIN_KEY=my-admin-key

# Optional: override public domain if auto-detection is wrong
# KOYRA_PUBLIC_HOST=your-service.koyeb.app

KOYRA_REMARK=Koyra-One
